{
  "name": "stolpy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "shots": "node scripts/shots.mjs",
    "demo": "esbuild scripts/demo-state.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/stolpy/demo-state.mjs && node node_modules/.cache/stolpy/demo-state.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:one": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.1"
  }
}
